# =============================================================================
# InvoiceFlow AI — LOCAL DEVELOPMENT ONLY
# =============================================================================
# Copy to .env in this folder (invoiceflow-ai/.env)
# Uses SQLite + local uploads/ — no Neon or Vercel Blob needed
# =============================================================================

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
PROVIDER_PRIORITY=gemini,groq,openrouter

# Optional overrides (defaults in app/config.py)
# UPLOAD_DIR=uploads
# DATABASE_PATH=invoiceflow.db
