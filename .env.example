# =============================================================================
# InvoiceFlow AI — LOCAL DEVELOPMENT ONLY
# =============================================================================
# Copy to .env and fill in your keys. Never commit .env.
#
# For Vercel production, use .env.vercel.example instead (see DEPLOY.md).
# Do NOT paste this file into the Vercel dashboard.
# =============================================================================

# --- LLM (at least GEMINI_API_KEY required) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
PROVIDER_PRIORITY=gemini,groq,openrouter

# --- Local storage (defaults work; SQLite + uploads/ folder) ---
# UPLOAD_DIR=uploads
# DATABASE_PATH=invoiceflow.db
