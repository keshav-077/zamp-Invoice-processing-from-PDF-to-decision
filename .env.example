# =============================================================================
# InvoiceFlow AI — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your API keys.
# Never commit .env to version control.
# See DEPLOY.md for Vercel production setup.
# =============================================================================

# --- LLM Provider API Keys ---
# At minimum, provide GEMINI_API_KEY. Others are optional fallbacks.
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Provider Configuration ---
PROVIDER_PRIORITY=gemini,groq,openrouter
GEMINI_MODEL=gemini-flash-latest
GROQ_MODEL=qwen/qwen3.6-27b
OPENROUTER_MODEL=google/gemini-2.5-flash

# --- Local database (dev) ---
UPLOAD_DIR=uploads
DATABASE_PATH=invoiceflow.db

# --- Production (Vercel) — REQUIRED on serverless ---
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# INNGEST_EVENT_KEY=...
# INNGEST_SIGNING_KEY=...
# INNGEST_APP_ID=invoiceflow-ai
# AUTO_SEED_ON_STARTUP=false

# --- File Constraints ---
MAX_FILE_SIZE_MB=50
MAX_PAGES=50

# --- Processing ---
MAX_RETRIES=1
ARITHMETIC_TOLERANCE=0.01
LLM_REQUEST_TIMEOUT_SECONDS=45
UPLOAD_API_TIMEOUT_SECONDS=300

# --- Server (local dev) ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Frontend (local dev — copy frontend/.env.example → frontend/.env) ---
# VITE_API_BASE_URL=http://localhost:8000/api
# Production/Vercel: VITE_API_BASE_URL=/api  (also set in vercel.json build.env)

# --- Stage 3 tax policy (US demo) ---
EXPECTED_TAX_RATE=0.08
TAX_TOLERANCE_PCT=0.12
USE_INVOICE_TAX_RATE=true

# --- Optional production ---
# CLERK_JWT_ISSUER=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RESEND_WEBHOOK_SECRET=
