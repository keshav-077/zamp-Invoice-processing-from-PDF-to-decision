# =============================================================================
# InvoiceFlow AI — Environment Variables (Vercel import this file)
# =============================================================================
# Vercel: Project Settings → Environment Variables → Import .env
#         Apply ALL keys to Production + Preview
#
# Fill empty values with your secrets. Keys with defaults can stay as-is.
# Local dev: copy .env.local.example → .env instead (see ENV.md)
# =============================================================================

# ── REQUIRED (must fill before deploy works) ─────────────────────────────────

GEMINI_API_KEY=
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
AUTO_SEED_ON_STARTUP=false
VERCEL_SUPPORT_LARGE_FUNCTIONS=1

# ── LLM FALLBACKS (fill keys; keep defaults) ──────────────────────────────────

GROQ_API_KEY=
OPENROUTER_API_KEY=
PROVIDER_PRIORITY=gemini,groq,openrouter
GEMINI_MODEL=gemini-flash-latest
GROQ_MODEL=qwen/qwen3.6-27b
OPENROUTER_MODEL=google/gemini-2.5-flash

# ── FRONTEND BUILD (Production + Preview) ────────────────────────────────────

VITE_API_BASE_URL=/api
VITE_USE_ASYNC_JOBS=true
VITE_UPLOAD_TIMEOUT_MS=300000

# ── ASYNC JOBS (recommended — get keys from inngest.com) ─────────────────────

INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_APP_ID=invoiceflow-ai

# ── OPTIONAL (leave blank unless you use the feature) ────────────────────────

CLERK_JWT_ISSUER=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEND_WEBHOOK_SECRET=
