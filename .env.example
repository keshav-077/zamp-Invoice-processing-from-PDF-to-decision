# =============================================================================
# InvoiceFlow AI — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your API keys.
# Never commit .env to version control.
# =============================================================================

# --- LLM Provider API Keys ---
# At minimum, provide GEMINI_API_KEY. Others are optional fallbacks.
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Provider Configuration ---
# Priority order for LLM providers (comma-separated)
PROVIDER_PRIORITY=gemini,groq,openrouter

# Model names per provider
GEMINI_MODEL=gemini-flash-latest
GROQ_MODEL=qwen/qwen3.6-27b
OPENROUTER_MODEL=google/gemini-2.5-flash

# --- Application Settings ---
UPLOAD_DIR=uploads
DATABASE_PATH=invoiceflow.db
MAX_FILE_SIZE_MB=50
MAX_PAGES=50

# --- Processing Settings ---
MAX_RETRIES=1
ARITHMETIC_TOLERANCE=0.01
LLM_REQUEST_TIMEOUT_SECONDS=45
UPLOAD_API_TIMEOUT_SECONDS=300

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Frontend (React dev server) ---
# Copy frontend/.env.example to frontend/.env
# VITE_API_BASE_URL=http://localhost:8000/api

# --- Stage 3 tax policy (US demo) ---
EXPECTED_TAX_RATE=0.08
TAX_TOLERANCE_PCT=0.12
USE_INVOICE_TAX_RATE=true
