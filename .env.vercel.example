# =============================================================================
# InvoiceFlow AI — VERCEL PRODUCTION
# =============================================================================
# Add these in Vercel → Project → Settings → Environment Variables
# Apply to: Production + Preview
#
# Do NOT import .env.example — that file is for local dev only.
# Copy each line below into Vercel (name = left side, value = your secret).
# =============================================================================

# ── REQUIRED ────────────────────────────────────────────────────────────────

GEMINI_API_KEY=
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
AUTO_SEED_ON_STARTUP=false

# ── LLM FALLBACKS (recommended) ─────────────────────────────────────────────

GROQ_API_KEY=
OPENROUTER_API_KEY=
PROVIDER_PRIORITY=gemini,groq,openrouter

# ── FRONTEND BUILD (Production + Preview) ─────────────────────────────────────
# Also set in vercel.json — add here if you override in the dashboard.

VITE_API_BASE_URL=/api
VITE_USE_ASYNC_JOBS=true

# ── ASYNC JOBS (recommended — invoices can take 60–120s+) ───────────────────
# After first deploy, sync Inngest app URL: https://YOUR-APP.vercel.app/api/inngest

INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_APP_ID=invoiceflow-ai

# ── OPTIONAL (uncomment only if you use these features) ───────────────────────

# GROQ_MODEL=qwen/qwen3.6-27b
# OPENROUTER_MODEL=google/gemini-2.5-flash
# GEMINI_MODEL=gemini-flash-latest
# CLERK_JWT_ISSUER=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RESEND_WEBHOOK_SECRET=
