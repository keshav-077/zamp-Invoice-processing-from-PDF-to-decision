{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "buildCommand": "cd frontend && npm ci && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "",
  "functions": {
    "app/main.py": {
      "maxDuration": 300,
      "excludeFiles": "{frontend/node_modules/**,frontend/src/**,tests/**,test_invoices/**,scripts/**,venv/**,.venv/**,uploads/**}"
    }
  },
  "env": {
    "PYTHONPATH": ".",
    "AUTO_SEED_ON_STARTUP": "false",
    "PROVIDER_PRIORITY": "gemini,groq,openrouter",
    "INNGEST_APP_ID": "invoiceflow-ai"
  },
  "build": {
    "env": {
      "VITE_API_BASE_URL": "/api",
      "VITE_USE_ASYNC_JOBS": "false",
      "VITE_UPLOAD_TIMEOUT_MS": "300000"
    }
  }
}
