# =============================================================================
# Frontend — LOCAL DEVELOPMENT ONLY
# =============================================================================
# Copy to frontend/.env
# Vercel production uses VITE_API_BASE_URL=/api (see .env.vercel.example)
# =============================================================================

VITE_API_BASE_URL=http://localhost:8000/api
VITE_UPLOAD_TIMEOUT_MS=300000
# false = sync upload (recommended local); true = async jobs (matches Vercel production)
VITE_USE_ASYNC_JOBS=false
